# Шаблон .env. Не копируйте руками — ./scripts/argus init создаст .env с
# правами 600 и сгенерирует все секреты (openssl rand -hex 24). Файл .env в git
# не попадает. Секреты обязательны: compose откажет с подсказкой, migrator не
# стартует на паролях argus / argus-* / change-me* (кроме стенда ARGUS_DEV=1).

# Зеркало Docker Hub (из РФ hub отдаёт 403): mirror.gcr.io | huecker.io | свой Harbor
REGISTRY_MIRROR=mirror.gcr.io

# ── ClickHouse: админ и служебные пользователи ────────────────────────────
# Админ (CLICKHOUSE_USER) нужен только migrator'у: миграции, CREATE USER, GRANT.
# Остальные сервисы работают каждый под своим пользователем с минимальными правами
# (см. scripts/migrate.sh): argus_ro (панели, readonly=1), argus_console (консоль),
# argus_collector, argus_shipper, argus_policyd, argus_engine.
CLICKHOUSE_USER=argus
CLICKHOUSE_PASSWORD=
CLICKHOUSE_RO_PASSWORD=
CLICKHOUSE_CONSOLE_PASSWORD=
CLICKHOUSE_COLLECTOR_PASSWORD=
CLICKHOUSE_SHIPPER_PASSWORD=
CLICKHOUSE_POLICYD_PASSWORD=
CLICKHOUSE_ENGINE_PASSWORD=
# Память ClickHouse (лимит контейнера; ClickHouse берёт 80 % от него). Ставьте
# по машине: 4g по умолчанию, в проде обычно 8–16g.
#CLICKHOUSE_MEM_LIMIT=8g
# Лимит памяти движка (compose). Буфер кандидатов живёт одно максимальное окно правил
# (+ два опроса): при NetFlow с границы и широких правилах (beacon) это сотни тысяч событий.
#ENGINE_MEM_LIMIT=2g
# Потолок буфера кандидатов, событий (≈ 1 КиБ каждое). Сверх него выбрасываются самые старые
# — окно самых широких правил урезается, зато движок не уходит в OOM-цикл; факт виден в
# /healthz (buffer_evicted) и в журнале. 0 — без предела.
#ENGINE_BUFFER_MAX=250000
# Потолок глубины буфера и стартового курсора после рестарта (окно самого широкого правила,
# но не глубже этого): правила с окном больше — например identity-device-churn на 24h —
# оцениваются по доступной глубине. Сутки событий после каждого рестарта — часы опроса.
#ENGINE_LOOKBACK_MAX=1h

# ── Консоль и Caddy ───────────────────────────────────────────────────────
# Имя хоста консоли для сертификата Caddy (кроме localhost/127.0.0.1)
CONSOLE_HOST=argus.local
# Внешний HTTPS-адрес вебхуков, если перед Caddy стоит балансировщик/другой порт.
#INGEST_PUBLIC_URL=https://argus.example.org:8089
# Свой сертификат консоли: файлы в ./caddy/certs
#CONSOLE_TLS=/certs/console.crt /certs/console.key
# Куда публиковать порты приёма по TLS (6514 syslog, 8089 вебхуки): 0.0.0.0 или адрес интерфейса
#INGEST_BIND=0.0.0.0
# Пароль admin НЕ задаётся здесь: он генерируется при первом старте и лежит в томе
# web-auth: docker compose exec web cat /data/admin-password.txt. После смены на
# странице «Настройки» файл удаляется. Там же включается TOTP 2FA.
# Прямой доступ без TLS: http://127.0.0.1:3001 с SESSION_SECURE=false.
#SESSION_SECURE=false

# ── Модуль Wazuh (необязательный источник) ─────────────────────────────────
# Wazuh — один из источников ARGUS, не ядро. Модуль включает три части:
# shipper (alerts.json менеджера → argus.wazuh_alerts), policyd (SCA и
# вердикты политик по API менеджера) и страницы «Управление»/SCA с панелями
# алертов в консоли. 0 — всё это выключено и скрыто, стек работает на
# коллекторе (syslog, вебхуки, NetFlow, телеметрия). Включить: 1 здесь и
# COMPOSE_PROFILES=wazuh ниже (./scripts/argus init --with-wazuh делает оба).
ARGUS_INTEGRATION_WAZUH=0
# Профили compose через запятую: wazuh (shipper, policyd), mcp (MCP-сервер по HTTP).
#COMPOSE_PROFILES=wazuh,mcp

# ── Wazuh manager API — policyd, движок (active-response) и раздел «Управление» ──
# Без менеджера консоль покажет «API недоступен», аналитика продолжит работать.
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=
# Доверие сертификату менеджера вместо WAZUH_INSECURE_TLS=true: CA-файл в
# ./caddy/certs (монтируется в /certs) или SHA-256 отпечаток листового сертификата.
#WAZUH_CA_FILE=/certs/wazuh-ca.pem
#WAZUH_CERT_SHA256=
#WAZUH_INSECURE_TLS=false
POLICY_POLL_INTERVAL=5m
# Бюджет раунда policyd на одного агента: таймаут раунда = max(POLL_INTERVAL, 2m,
# бюджет × число агентов). Старое имя POLICY_PER_AGENT_TIMEOUT ещё читается.
#POLICY_ROUND_BUDGET_PER_AGENT=5s
# Bearer для GET /verdicts policyd; пусто — только по сети compose
#POLICYD_TOKEN=
# Продовый источник алертов: каталог с alerts.json (по умолчанию — демо ./sample).
# Монтируется каталог, а не файл — иначе Docker не покажет ротацию.
#WAZUH_ALERTS_DIR=/var/ossec/logs/alerts
# Строка alerts.json длиннее лимита пропускается (байт)
#SHIPPER_MAX_LINE_BYTES=4194304
# Шиппер → ClickHouse по https (внешний ClickHouse вне compose): PEM с CA, которым
# подписан его сертификат. Обязателен при https:// — rustls в шиппере собран без
# системных корней (сборка детерминирована), и без CA соединение отвергается.
#CLICKHOUSE_CA_FILE=/certs/clickhouse-ca.pem
# Мастер добавления агента: адрес менеджера для команд установки; 1 — на менеджере
# включён пароль регистрации (authd), команда попросит его ввести
#WAZUH_MANAGER_HOST=wazuh.corp.local
#WAZUH_REGISTRATION_PASSWORD_SET=0

# ── Коллектор ─────────────────────────────────────────────────────────────
# Токен вебхуков и /ingest/* (заголовок X-Argus-Token). Обязателен; стенд: ARGUS_DEV=1.
ARGUS_INGEST_TOKEN=
#ARGUS_DEV=1
# Syslog по TLS (RFC 5425): выключен, пока SYSLOG_TLS_ADDR пуст. Включить — адрес :6514,
# сертификат и ключ в ./collector/certs (монтируется в /certs); без них коллектор не
# стартует (стенд ARGUS_DEV=1 — самоподписанный). CLIENT_CA — mTLS: принимать только
# источники с сертификатом от этого CA.
#SYSLOG_TLS_ADDR=:6514
#SYSLOG_TLS_CERT=/certs/syslog.crt
#SYSLOG_TLS_KEY=/certs/syslog.key
#SYSLOG_TLS_CLIENT_CA=/certs/syslog-clients-ca.pem
# Очередь на запись в ClickHouse (строк); сверх — дроп с метрикой argus_collector_events_dropped_total
#SINK_PENDING_ROWS=200000
#COLLECTOR_LOG_LEVEL=info
# Одновременных TCP/TLS-соединений syslog (защита от исчерпания дескрипторов)
#SYSLOG_TCP_MAX_CONNS=1024
# Allow-list экспортеров NetFlow (CIDR через запятую); пусто — принимать от всех
#NETFLOW_EXPORTERS=10.0.0.0/8,192.168.1.1/32
# Свои сети (CIDR через запятую): направление потока NetFlow — attrs.scope inbound | outbound |
# internal | external, и attrs.syn_only=1 у TCP-попыток без ответа (SYN без ACK). Пусто —
# RFC 1918, 100.64/10, loopback; собственные белые блоки перечислить явно. Те же сети движок
# добавляет в allowlist обратного канала: свои адреса не блокируются ни кнопкой, ни правилом.
#INTERNAL_NETS=192.168.0.0/20,185.25.9.0/24
# Внешние адреса NAT (через запятую, адрес или CIDR). Если NetFlow шлют и шлюз LAN (до NAT),
# и пограничный маршрутизатор (после NAT), каждый исходящий разговор приходит дважды:
# с внутренним адресом и с адресом NAT. Потоки с этими адресами получают attrs.post_nat=1,
# правила по исходящему трафику их пропускают. Не задавайте, если до-NAT потоков нет.
#FLOW_NAT_ADDRS=185.25.9.57
# CrowdStrike Falcon Streaming API (collector.yml → falcon); выключен без client_id
#FALCON_BASE_URL=https://api.crowdstrike.com
#FALCON_CLIENT_ID=
#FALCON_CLIENT_SECRET=
# Yandex Cloud Audit Trails / VK Cloud — экспорт в S3-бакет (collector.yml → s3)
#YC_AUDIT_BUCKET=
#YC_AUDIT_PREFIX=
#YC_S3_ACCESS_KEY=
#YC_S3_SECRET_KEY=

# ── Движок корреляции и LLM-аналитик ──────────────────────────────────────
# Токен управляющих POST движка (консоль шлёт X-Argus-Token). Обязателен; стенд — ARGUS_DEV=1.
ENGINE_TOKEN=
ENGINE_POLL_INTERVAL=30s
# Профили аналитика (engine/argus.analyst.yml): mock | on-prem-strict.
# Инциденты с ПДн идут ТОЛЬКО в ARGUS_ANALYST_PII_PROFILE; в бою — on-prem-strict.
ARGUS_ANALYST_PROFILE=mock
ARGUS_ANALYST_PII_PROFILE=mock
# Стенд без модели: все правила принудительно в mock. В бою оставьте пустым —
# тогда работает профиль из правила (on-prem-strict).
ARGUS_ANALYST_FORCE_PROFILE=mock
# Bearer для /metrics движка (Prometheus: authorization.credentials); пусто — тот же ENGINE_TOKEN
#METRICS_TOKEN=
# Потолок новых инцидентов за цикл движка (защита от шторма правил)
#ARGUS_MAX_NEW_INCIDENTS=200
# Паспорт субъекта: персоны и алиасы (email, login, uid, ip, host, sid, peer,
# phone) с интервалами действия — ./identities.yml, смонтирован в движок как
# /etc/argus/identities.yml (compose) и перечитывается при изменении. Алиасы
# также приходят событиями identity.alias от экспортеров (IdP, VPN-контроллер)
# и через API консоли; политики алиасов из событий (блок policies того же
# файла) ограничивают источники, число открытых и частоту смены — нарушения
# пишутся событиями argus.identity / identity.policy.violation. Секретов здесь
# нет; путь задаётся в docker-compose.yml. Без IDENTITIES_FILE политик нет.
# Параллельных запросов к модели и потолок разборов в сутки (дальше — инциденты без вердикта)
#ANALYST_CONCURRENCY=4
#ANALYST_DAILY_LIMIT=500
# Локальный OpenAI-совместимый эндпоинт (vLLM, Ollama, llama.cpp) внутри контура —
# профиль on-prem-strict. Умолчания нет: с пустым ARGUS_LLM_LOCAL_ENDPOINT выбранный
# профиль on-prem-strict не стартует (понятная ошибка в логе движка).
# По plain http только внутри контура; false — только https.
#ARGUS_LLM_LOCAL_PLAIN_HTTP=true
#ARGUS_LLM_LOCAL_ENDPOINT=https://llm.example.org/v1
#ARGUS_LLM_LOCAL_MODEL=qwen3-32b-instruct
#ARGUS_LLM_LOCAL_API_KEY=                              # если локальный сервер требует ключ — только здесь
# Telegram-эскалация: токен бота — только в окружении, chat_id — в argus.analyst.yml/ENV.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# Уведомлений в минуту на канал; сверх — агрегируются в одно сообщение
#NOTIFY_TELEGRAM_PER_MINUTE=20
#NOTIFY_EMAIL_PER_MINUTE=20
# Почтовая эскалация (argus.analyst.yml → notify.email)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=argus@corp.local
#SMTP_TO=soc@corp.local
# Регулярный отчёт по открытым рискам, владельцам и срокам: 24h / 168h.
# Требуются SMTP_HOST, SMTP_FROM и SMTP_TO; пусто — отправка выключена.
# Первое письмо сразу после включения, затем от последней успешной доставки.
#RISK_REPORT_INTERVAL=24h

# Исходящие вебхуки движка (argus.analyst.yml → notify.webhooks). Пустой адрес — цель выключена.
# Ссылка на карточку инцидента в теле вебхука: <ARGUS_CONSOLE_URL>/incidents/<id>.
#ARGUS_CONSOLE_URL=https://argus.example.org
# Ключ псевдонимов субъектов и отпечатков секретов для mcp в профиле triage
# (≥32 символов, argus init генерирует).
#ARGUS_PSEUDONYM_KEY=
# Произвольный приёмник: подпись X-Argus-Signature: sha256=<HMAC-SHA256 тела>, секрет ≥32 символов.
#ARGUS_WEBHOOK_URL=
#ARGUS_WEBHOOK_SECRET=
#ARGUS_WEBHOOK_TOKEN=

# Дисковая очередь коллектора на томе collector-state, по умолчанию 8 ГБ.
# Оставьте на томе место для ClickHouse/бэкапов отдельно; при заполнении
# вебхуки получают 503, источники TCP/TLS ждут освобождения места.
#SINK_SPOOL_BYTES=8589934592

# ── Реагирование (IPS/IDS) ────────────────────────────────────────────────
# ids — только детект; simulate — журнал «кого бы заблокировал» (по умолчанию); ips — автоблокировка.
# Переключается и в консоли («Настройки → Реагирование», администратор).
#ARGUS_RESPOND_MODE=simulate
#ARGUS_RESPOND_TTL=1h
# Ручная блокировка из карточки инцидента: снимается по TTL (0 — бессрочно); снять раньше —
# кнопка «Разблокировать» (POST /respond/unblock движка).
#ARGUS_RESPOND_MANUAL_TTL=24h
# Никогда не блокировать: свои внешние адреса (в т.ч. балансировщик перед WAF!), мониторинг, VPN админов.
#ARGUS_RESPOND_NEVER_BLOCK_1=185.0.0.0/24
#ARGUS_RESPOND_NEVER_BLOCK_2=
#ARGUS_RESPOND_NEVER_BLOCK_3=
# Доверенные источники (CIDR адресов коллектора/агентов): автоблокировка только по событиям
# от них — адрес из подделанного syslog не приведёт к блокировке.
#ARGUS_RESPOND_TRUSTED_1=10.0.0.0/8
#ARGUS_RESPOND_TRUSTED_2=
#ARGUS_RESPOND_TRUSTED_3=
# Совместимость: старый allowlist (то же, что NEVER_BLOCK)
#ARGUS_RESPOND_ALLOWLIST_1=
#ARGUS_RESPOND_ALLOWLIST_2=
# Исполнитель active-response Wazuh: id агентов через запятую (пусто — выключен; all — все, с
# предупреждением), таймаут блока в секундах = <timeout> команды в ossec.conf, команда снятия.
#WAZUH_AR_AGENTS=001,002
#WAZUH_AR_TIMEOUT=3600
#WAZUH_AR_UNBLOCK_COMMAND=firewall-drop-unblock0
#NGFW_BLOCK_URL=https://ug.corp/api/v1/ip_lists/blocked/add
#NGFW_UNBLOCK_URL=https://ug.corp/api/v1/ip_lists/blocked/remove   # пусто — снятие по TTL невозможно, блок постоянный
#NGFW_EXPECT="\"success\":true"                                     # подстрока в ответе, подтверждающая блокировку
#NGFW_TOKEN=

# ── WAF: ModSecurity / Coraza ─────────────────────────────────────────────
# Каталог с логами WAF на хосте монтируется в /logs/waf коллектора.
#WAF_LOG_DIR=/var/log/waf
#WAF_AUDIT_LOG=/logs/waf/modsec_audit.log   # SecAuditLogFormat JSON (ModSecurity v3, Coraza)
#WAF_ERROR_LOG=/logs/waf/error.log          # error-лог nginx/Apache или JSON-лог Caddy с Coraza
#WAF_FROM_START=false
#WAF_NODE=waf-01            # имя хоста WAF — узел его событий; [hostname] лога узлом не бывает (у ModSecurity это Host от клиента, у Coraza адрес контейнера)
#WAF_CONTAINER=caddy        # имя контейнера WAF → attrs.container

# ── MCP для агентов разбора по сети (профиль compose mcp) ──────────────────
# Caddy публикует argus-mcp на :8445 (TLS как у консоли). MCP_BIND=0.0.0.0 открывает порт
# наружу, MCP_ALLOWED_NETS — сети клиентов через запятую или пробел (остальным 403).
# Элемент, не похожий на адрес или CIDR, отбрасывается с предупреждением в журнале caddy,
# а не роняет Caddy.
# Клиенты с самого хоста приходят в контейнер с адреса шлюза Docker. MCP_ALLOW_HOST=1
# разрешает шлюз; по умолчанию он разрешён только при MCP_BIND на loopback (тогда до порта
# дотягивается лишь сам хост). ВНИМАНИЕ: в rootless Docker, при "userland-proxy"/без iptables
# и на Docker Desktop с адреса шлюза приходят ВСЕ клиенты — там при MCP_BIND=0.0.0.0 не
# включайте MCP_ALLOW_HOST: список сетей перестанет что-либо отсекать, останется только bearer.
# Bearer — ARGUS_MCP_HTTP_TOKEN, профиль ответов — ARGUS_MCP_PROFILE (triage для облачной модели).
#MCP_BIND=127.0.0.1
#MCP_ALLOWED_NETS=10.170.77.0/24,10.200.0.0/16
#MCP_ALLOW_HOST=          # 1 — пускать клиентов с самого хоста при MCP_BIND=0.0.0.0 (только если Docker сохраняет адреса клиентов)
#ARGUS_MCP_PROFILE=full

# ── SSO через IdP (OIDC: Authentik, Keycloak) ─────────────────────────────
# Группы IdP синхронизируются в роли консоли на каждом входе (claim groups).
# Пользователи SSO живут в auth.json с префиксом sso: (sso:<subject>) — с локальными
# не пересекаются. Пусто — только локальные пользователи. Секрет клиента — только здесь.
#OIDC_ISSUER=https://auth.corp.local/application/o/argus/
#OIDC_CLIENT_ID=argus-console
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URL=https://argus.corp.local:8443/api/auth/oidc/callback
#OIDC_GROUPS_CLAIM=groups
#OIDC_GROUP_ADMIN=argus-admins
#OIDC_GROUP_ANALYST=argus-analysts
#OIDC_GROUP_VIEWER=argus-viewers
#OIDC_DEFAULT_ROLE=            # роль, если ни одна группа не совпала; пусто — отказ во входе

# ── API и MCP ─────────────────────────────────────────────────────────────
# Bearer-токен API консоли для MCP-сервера и скриптов (только чтение, ≥32 символов).
# Пусто — API доступно только по сессии консоли.
#ARGUS_API_TOKEN=
# Учётка-эмитент сессий разбора для внешних агентов: только выпуск токенов
# triage-session (POST /api/triage/sessions), читать ей ничего нельзя. ≥32 символов и
# не равен ARGUS_API_TOKEN. Пусто — сессии разбора не выпускаются.
#ARGUS_TRIAGE_ISSUER_TOKEN=
# Запросов к API за одну сессию разбора (по умолчанию 100).
#ARGUS_TRIAGE_SESSION_REQUESTS=
# Частое значение не якорь области разбора: встречается у стольких разных субъектов или
# узлов за ±24 ч от инцидента (по умолчанию 5, обоснование — README, «Сессия разбора»).
#ARGUS_TRIAGE_ANCHOR_MAX_SPREAD=
# Bearer MCP-сервера по HTTP (профиль mcp) — обязателен в режиме -http, ≥32 символов и
# не равен ARGUS_API_TOKEN (argus init генерирует оба); allow-list браузерных Origin.
#ARGUS_MCP_HTTP_TOKEN=
#ARGUS_MCP_ALLOWED_ORIGINS=
# Лимит запросов к MCP по HTTP в минуту на один bearer (или Mcp-Session-Id)
#ARGUS_MCP_RATE_PER_MIN=300
# Токен агента разбора: его запросы всегда в профиле triage (редакция до модели, псевдонимы,
# только точные фильтры, include_raw запрещён). ≥32 символов, отличается от других токенов.
#ARGUS_MCP_TRIAGE_TOKEN=
# Профиль по умолчанию (stdio и ARGUS_MCP_HTTP_TOKEN): full | triage
#ARGUS_MCP_PROFILE=full
# Канарейки для редакции (через запятую; *CANARY* вырезается и без списка) и словарь имён
# людей (файл, по строке) — имена в свободном тексте шаблонами не ловятся.
#ARGUS_REDACT_CANARIES=
#ARGUS_REDACT_NAMES_FILE=

# ── Прод: образы, бэкапы ──────────────────────────────────────────────────
# Образы из реестра вместо сборки на хосте: make deploy (см. README «Обновление»)
#ARGUS_IMAGE_PREFIX=ghcr.io/k1dory/argus
# Публичный ключ cosign: make deploy проверяет подписи образов (пусто — не проверяет)
#COSIGN_PUBKEY=./cosign.pub
# Бэкапы (scripts/backup.sh): каталог вне дерева проекта, срок хранения, ключ шифрования
# тома web-auth (пользователи, TOTP-секреты). Без ключа бэкап отказывает.
# age: BACKUP_AGE_RECIPIENT=age1... (восстановление — BACKUP_AGE_IDENTITY=/path/key.txt);
# иначе openssl enc с BACKUP_KEY. Ключ хранить отдельно от бэкапов.
#BACKUP_DIR=/var/backups/argus
#BACKUP_KEEP_DAYS=14
#BACKUP_KEY=
#BACKUP_AGE_RECIPIENT=
#BACKUP_AGE_IDENTITY=
