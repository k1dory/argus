# Дефолты стенда для `make up-dev` (docker compose --env-file .env.dev …).
# Пароли заведомо слабые и попадают в git — только для локального стенда и CI.
# В бою: ./scripts/argus init → .env (права 600), этот файл не используется.
REGISTRY_MIRROR=mirror.gcr.io
ARGUS_DEV=1

CLICKHOUSE_USER=argus
CLICKHOUSE_PASSWORD=argus
CLICKHOUSE_RO_PASSWORD=argus-ro
CLICKHOUSE_CONSOLE_PASSWORD=argus-console
CLICKHOUSE_COLLECTOR_PASSWORD=argus-collector
CLICKHOUSE_SHIPPER_PASSWORD=argus-shipper
CLICKHOUSE_POLICYD_PASSWORD=argus-policyd
CLICKHOUSE_ENGINE_PASSWORD=argus-engine

# Модуль Wazuh на стенде выключен: без менеджера shipper/policyd не нужны
# (COMPOSE_PROFILES=wazuh и ARGUS_INTEGRATION_WAZUH=1 включают их).
ARGUS_INTEGRATION_WAZUH=0
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=change-me
ARGUS_INGEST_TOKEN=dev-ingest-token-not-for-production
ENGINE_TOKEN=dev-engine-token-not-for-production
ARGUS_API_TOKEN=dev-api-token-not-for-production-0001
ARGUS_MCP_HTTP_TOKEN=dev-mcp-token-not-for-production-0002
ARGUS_TRIAGE_ISSUER_TOKEN=dev-triage-issuer-token-not-for-production-04
ARGUS_PSEUDONYM_KEY=dev-pseudonym-key-not-for-production-03

ARGUS_ANALYST_PROFILE=mock
ARGUS_ANALYST_PII_PROFILE=mock
ARGUS_ANALYST_FORCE_PROFILE=mock
ENGINE_POLL_INTERVAL=10s
# Паспорт субъекта на стенде: ./identities.yml (три персоны, согласованные с
# cmdb.yml и fixtures/events/identity.ndjson) монтируется движком через compose.
WAF_AUDIT_LOG=/logs/waf/modsec_audit.log
WAF_FROM_START=true
